# Copiar a .env en el servidor. .env nunca se versiona.

TZ=America/Mexico_City

# Un solo dominio: los mapas en la raiz y por ruta, el editor en /admin.
MAPA_HOST=mapa.aprende.gob.mx

# Imagenes, etiquetadas con la version desplegada. Se construyen juntas.
EDITOR_IMAGE=mapa-editor:2026-10-05
TOOLS_IMAGE=mapa-tools:2026-10-05

# Base de datos. Generar la contrasena con: openssl rand -base64 30
POSTGRES_DB=mapa
POSTGRES_USER=mapa
POSTGRES_PASSWORD=cambiar-esto

# Tope por archivo subido, en bytes. 2 GB por omision.
MAX_UPLOAD_BYTES=2147483648

# Dias que sobrevive un archivo despues de quitarlo de su medio. Es tambien
# hasta donde se puede volver en el historial: pasada esa fecha, una version que
# referencie esos archivos ya no se puede republicar.
RETENER_ARCHIVOS_DIAS=90
