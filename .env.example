# Copiar a .env en el servidor. .env nunca se versiona.

TZ=America/Mexico_City

# Dominios
MAPA_HOST=mapa.redmexico.aprende.gob.mx
EDITOR_HOST=editor.mapa.redmexico.aprende.gob.mx

# Imagen del editor, construida y etiquetada con la version desplegada.
EDITOR_IMAGE=mapa-editor:2026-09-15

# Base de datos. Generar la contrasena con: openssl rand -base64 30
POSTGRES_DB=mapa
POSTGRES_USER=mapa
POSTGRES_PASSWORD=cambiar-esto

# Tope por archivo subido, en bytes. 2 GB por omision.
MAX_UPLOAD_BYTES=2147483648
