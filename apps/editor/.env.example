# Copiar a .env y ajustar. .env nunca se versiona.

# Base de datos. En desarrollo apunta al contenedor de docker-compose.dev.yml.
NUXT_DATABASE_URL=postgres://mapa:mapa_dev@127.0.0.1:5432/mapa

# Solo para desarrollo sin HTTPS. En produccion se omite: las cookies de sesion
# deben viajar con Secure, y el valor por defecto es el seguro.
NUXT_INSECURE_COOKIES=true
