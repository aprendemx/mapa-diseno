{
  // Los guiones de mantenimiento quedaban fuera del typecheck de Nuxt, que solo
  // mira app/ y server/. Por eso el barrido de huerfanos sobrevivio a un cambio
  // de firma: perdio el argumento del mapa, dejo de ver referencias y empezo a
  // reportar los 66 archivos vivos como huerfanos --ofreciendo borrarlos.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["scripts/**/*.ts"]
}
